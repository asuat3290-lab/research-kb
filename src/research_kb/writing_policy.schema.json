    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "severity",
          "enforcement",
          "profiles",
          "ignore"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "forbidden_term",
              "regex",
              "budget",
              "section_numbering",
              "argument_gain",
              "required_section",
              "required_section_content",
              "footnote_integrity",
              "bibliography",
              "citation_surface",
              "compression_duplicate",
              "compression_limit_echo",
              "bibliography_completeness"
            ]
          },
          "severity": {
            "enum": [
